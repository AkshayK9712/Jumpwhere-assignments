# Staging: a production-like copy for testing. Copy to .env on the staging server.
ENVIRONMENT=staging
LOG_LEVEL=INFO

POSTGRES_USER=iot
POSTGRES_PASSWORD=change-me-staging-db-password
POSTGRES_DB=iotdb
DATABASE_URL=postgresql+psycopg2://iot:change-me-staging-db-password@db:5432/iotdb

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-long-random-value
API_BASE_URL=https://staging.iot.example.com
CORS_ORIGINS=https://staging.iot.example.com

REQUIRE_EMAIL_VERIFICATION=true
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=apikey-or-username
SMTP_PASSWORD=smtp-password
EMAIL_FROM=no-reply@staging.iot.example.com

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10

# demo data is fine on staging
SEED_ON_START=true
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@staging.example.com
ADMIN_PASSWORD=change-me-Staging-1
WEB_CONCURRENCY=2
