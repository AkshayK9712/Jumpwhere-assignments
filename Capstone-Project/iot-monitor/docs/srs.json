    "roles": [
      "admin",
      "user",
      "guest"
    ],
    "rules": {
      "Register / login / verify email": [
        "public"
      ],
      "View own account and profile": [
        "admin",
        "user",
        "guest"
      ],
      "Edit own account and profile": [
        "admin",
        "user"
      ],
      "List and view sensors and readings": {
        "admin": "all",
        "user": "own sensors",
        "guest": "all, read-only"
      },
      "Create / edit / delete sensors and readings": {
        "admin": "all",
        "user": "own sensors",
        "guest": "no"
      },
      "Dashboard": [
        "admin",
        "user",
        "guest"
      ],
      "Create and download reports": {
        "admin": "yes",
        "user": "yes",
        "guest": "view and download only"
      },
