  "traceability_notes": {
    "API-001": "Satisfied by the whole spec in docs/api-spec.yaml: OpenAPI 3, /api/v1 versioning, 429 rate limiting.",
    "API-002": "Implemented in src/frontend/js/api.js: bearer token handling, single-flight refresh on 401, retry with back-off (GET/PUT/DELETE on network errors and 502-504; any method on 429), normalized errors. Real-time sync arrives with the dashboard (polling)."
  },
