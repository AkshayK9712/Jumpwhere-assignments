Table users {
  id int [pk, increment]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  name varchar(120) [not null]
  role varchar(20) [not null, default: 'user', note: 'admin | user | guest']
  is_active boolean [not null, default: false]
  email_verified boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  last_login timestamptz
}

Table user_profiles {
  id int [pk, increment]
  user_id int [unique, not null, ref: - users.id]
  avatar_url varchar(500)
  bio varchar(500)
  phone varchar(30)
  preferences jsonb [not null, default: '{}']
  timezone varchar(64) [not null, default: 'UTC']
  language varchar(10) [not null, default: 'en']
}

Table sensors {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  title varchar(150) [not null]
  description text
  status varchar(20) [not null, default: 'active', note: 'active | inactive | faulty']
  priority varchar(20) [not null, default: 'medium', note: 'low | medium | high | critical']
  category varchar(20) [not null, note: 'temperature | pressure | humidity | vibration | flow | other']
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    status
    category
  }
}

Table sensor_readings {
  id bigint [pk, increment]
  sensor_id int [not null, ref: > sensors.id]
  value float [not null]
  recorded_at timestamptz [not null]

  indexes {
    (sensor_id, recorded_at)
  }
}

Table activity_logs {
  id bigint [pk, increment]
  user_id int [ref: > users.id]
  action varchar(50) [not null]
  entity_type varchar(50)
  entity_id int
  details jsonb [not null, default: '{}']
  ip_address varchar(45)
  user_agent varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id)
    created_at
  }
}

Table reports {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  name varchar(150) [not null]
  query_params jsonb [not null, default: '{}']
  format varchar(10) [not null, note: 'pdf | csv']
  status varchar(10) [not null, default: 'pending']
  scheduled boolean [not null, default: false]
  file_path varchar(500)
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
}

Table system_config {
  id int [pk, increment]
  key varchar(100) [unique, not null]
  value jsonb
  description varchar(255)
  is_active boolean [not null, default: true]
  updated_by int [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]
}

Table refresh_tokens {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  token_hash varchar(128) [unique, not null]
  expires_at timestamptz [not null]
  revoked boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
}
