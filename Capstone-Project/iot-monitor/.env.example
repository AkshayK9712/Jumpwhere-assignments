DATABASE_URL=postgresql+psycopg2://iot:iot@db:5432/iotdb
JWT_SECRET=change-me-to-a-long-random-string
AUTH_PROVIDER_KEY=change-me
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth
REQUIRE_EMAIL_VERIFICATION=true

# Email: console (prints the link in the server log) | smtp (MailHog in Docker)
EMAIL_BACKEND=console
SMTP_HOST=mailhog
SMTP_PORT=1025

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10

# Seed data
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
SEED_DEMO_DATA=true

# Running WITHOUT Docker? Replace DATABASE_URL above with:
# DATABASE_URL=sqlite:///./dev.db
