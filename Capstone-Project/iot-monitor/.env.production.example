# Production. Copy to .env on the server and replace EVERY value marked CHANGE.
# The app refuses to start in production with a weak JWT_SECRET.
ENVIRONMENT=production
LOG_LEVEL=INFO

POSTGRES_USER=iot
POSTGRES_PASSWORD=CHANGE-long-random-database-password
POSTGRES_DB=iotdb
DATABASE_URL=postgresql+psycopg2://iot:CHANGE-long-random-database-password@db:5432/iotdb

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-at-least-32-random-characters
API_BASE_URL=https://iot.example.com
CORS_ORIGINS=https://iot.example.com

REQUIRE_EMAIL_VERIFICATION=true
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=CHANGE
SMTP_PASSWORD=CHANGE
EMAIL_FROM=no-reply@iot.example.com

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=10

REPORTS_RETENTION_DAYS=30
SCHEDULER_ENABLED=true

# Create the first admin ONCE: set SEED_ON_START=true with a strong ADMIN_PASSWORD, start, then set it back to false.
SEED_ON_START=false
SEED_DEMO_DATA=false
ADMIN_EMAIL=admin@iot.example.com
ADMIN_PASSWORD=CHANGE-strong-admin-password
WEB_CONCURRENCY=2
